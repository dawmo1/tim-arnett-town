{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room === 'WORLD'",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room === 'WORLD'",
            ".validate": "newData.hasChildren(['n'])",
            "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && !newData.val().matches(/[<>]/)" },
            "c": { ".validate": "!newData.child('40').exists()", "$i": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 16)" } },
            "a": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "j": { ".validate": "newData.isNumber()" },
            "s": { ".validate": "!newData.child('24').exists()", "$i": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 48)" } },
            "$other": { ".validate": false }
          }
        },
        "vehicles": {
          "$vid": {
            ".write": "auth != null && $room === 'WORLD' && $vid.matches(/^[A-Za-z0-9_-]{1,48}$/)",
            ".validate": "!newData.exists() || (newData.child('x').isNumber() && newData.child('z').isNumber() && newData.child('ti').isNumber())",
            "m": { ".validate": "!newData.child('10').exists()" },
            "dz": { ".validate": "!newData.child('6').exists()" },
            "d": { ".validate": "newData.isString() && newData.val().length <= 48" },
            "bb": { ".validate": "newData.isString() && newData.val().length <= 48" }
          }
        },
        "cops": {
          "$host": { ".write": "auth != null && auth.uid === $host && $room === 'WORLD'" }
        },
        "events": {
          ".indexOn": ["t"],
          "$e": {
            ".write": "auth != null && $room === 'WORLD' && (newData.exists() ? newData.child('from').val() === auth.uid : (data.child('from').val() === auth.uid || (data.child('t').isNumber() && data.child('t').val() < now - 60000)))"
          }
        },
        "world": {
          ".write": "auth != null && $room === 'WORLD' && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['off', 'w', 'sm'])",
          "off": { ".validate": "newData.isNumber()" },
          "fz": { ".validate": "newData.isNumber()" },
          "w": { ".validate": "newData.isString() && newData.val().matches(/^(|clear|cloudy|rain|storm|fog|snow)$/)" },
          "sm": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1" },
          "$other": { ".validate": false }
        },
        "chat": {
          "$m": {
            ".write": "auth != null && $room === 'WORLD' && (!data.exists() || (!newData.exists() && data.child('t').isNumber() && data.child('t').val() < now - 3600000) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
            ".validate": "newData.child('m').isString() && newData.child('m').val().length >= 1 && newData.child('m').val().length <= 120 && newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 16",
            "u": { ".validate": "newData.val() === auth.uid" }
          }
        }
      }
    },
    "secret": { ".read": false, ".write": false },
    "adminKeys": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.val() === true && root.child('secret/adminCode').isString() && root.child('adminKeys').child($uid).val() === root.child('secret/adminCode').val()))"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['cash', 't'])",
        "v": { ".validate": "newData.isNumber()" },
        "t": { ".validate": "newData.isNumber()" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && !newData.val().matches(/[<>]/)" },
        "cash": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
        "armor": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "ammo": { ".validate": "!newData.child('40').exists()", "$i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" } },
        "st": { ".validate": "!newData.child('8').exists()", "$i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" } },
        "done": { ".validate": "!newData.child('30').exists()", "$i": { ".validate": "newData.isString() && newData.val().length <= 16" } },
        "look": { ".validate": "!newData.child('40').exists()", "$i": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 16)" } },
        "pos": {
          ".validate": "newData.hasChildren(['x', 'z'])",
          "x": { ".validate": "newData.isNumber() && newData.val() >= -13000 && newData.val() <= 39000" },
          "z": { ".validate": "newData.isNumber() && newData.val() >= -12000 && newData.val() <= 14000" },
          "h": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
          "s": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "gar": {
          "sel": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12" },
          "cars": {
            ".validate": "!newData.child('12').exists()",
            "$i": {
              ".validate": "newData.hasChildren(['ti'])",
              "ti": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
              "color": { ".validate": "newData.isNumber()" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 32" },
              "mods": {
                "engine": { ".validate": "newData.isNumber()" }, "brakes": { ".validate": "newData.isNumber()" }, "suspension": { ".validate": "newData.isNumber()" },
                "turbo": { ".validate": "newData.isNumber()" }, "armor": { ".validate": "newData.isNumber()" }, "bp": { ".validate": "newData.isNumber()" },
                "nitro": { ".validate": "newData.isNumber()" }, "tint": { ".validate": "newData.isNumber()" }, "neon": { ".validate": "newData.isNumber()" },
                "horn": { ".validate": "newData.isNumber()" },
                "plate": { ".validate": "newData.isString() && newData.val().length <= 8" },
                "paint": { "c1": { ".validate": "newData.isNumber()" }, "c2": { ".validate": "newData.isNumber()" }, "f": { ".validate": "newData.isNumber()" }, "$other": { ".validate": false } },
                "rims": { "s": { ".validate": "newData.isNumber()" }, "c": { ".validate": "newData.isNumber()" }, "$other": { ".validate": false } },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
