{
  "name": "tim-arnett-town-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node build-vendor.mjs",
    "fetch": "node fetch-map.mjs",
    "map": "node --max-old-space-size=3500 build-map.mjs",
    "ms": "node --max-old-space-size=1500 ms-extract.mjs",
    "checks": "node map-stats.mjs now && node check-roads.mjs now && node --max-old-space-size=1024 fix-road-overlaps.mjs && node --max-old-space-size=2500 scan-placement.mjs",
    "roadclear": "node --max-old-space-size=1024 fix-road-overlaps.mjs --write",
    "pbf": "node --max-old-space-size=6000 pbf-extract.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@recast-navigation/core": "0.44.0",
    "@recast-navigation/generators": "0.44.0",
    "earcut": "3.2.4",
    "esbuild": "0.28.2",
    "osm-pbf-parser": "2.3.0",
    "pngjs": "7.0.0",
    "three": "0.160.0"
  }
}
